{
  "type": "module",
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "style-dictionary": "^4.4.0"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@tokens-studio/sd-transforms": "^1.3.0"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production babel build/css --out-dir dist --copy-files && node build-output.js && cp build/js/colors.js dist/",
    "create": "node build-output.js"
  },
  "babel": {
    "presets": [
      [
        "@babel/env",
        {
          "targets": {
            "edge": "17",
            "firefox": "60",
            "chrome": "67",
            "safari": "11.1"
          },
          "useBuiltIns": "usage",
          "corejs": "3.6.5"
        }
      ],
      "@babel/preset-react"
    ]
  },
  "name": "@rayelder/iris-token-builder",
  "version": "0.0.1",
  "private": false,
  "description": "Token builder for the Iris Design System",
  "main": "main.js"
}
